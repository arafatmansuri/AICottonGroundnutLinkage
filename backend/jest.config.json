{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "roots": ["<rootDir>/tests"],
  "testMatch": ["**/*.test.ts"],
  "moduleFileExtensions": ["ts", "js"],
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "tsconfig": { "strict": false } }]
  },
  "passWithNoTests": true,
  "coverageDirectory": "coverage",
  "collectCoverageFrom": ["src/**/*.ts"]
}
