// KisanMitra AI — Prisma Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  FARMER
  BUYER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum BuyerVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum CropQuality {
  GRADE_A
  GRADE_B
  GRADE_C
  UNGRADED
}

enum StorageStatus {
  NOT_STORED
  IN_STORAGE
  PARTIALLY_STORED
}

enum TransactionStatus {
  OFFER_CREATED
  OFFER_SENT
  ACCEPTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
  EXPIRED
  DISPUTED
}

enum NotificationType {
  PRICE_ALERT
  BUYER_MATCH
  MARKET_ALERT
  TRANSACTION_UPDATE
  AI_RECOMMENDATION
  SYSTEM
}

enum RecommendationDecision {
  SELL_NOW
  STORE
  SELL_PARTIALLY
  WAIT_AND_MONITOR
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum PriceTrend {
  INCREASING
  DECREASING
  STABLE
  VOLATILE
}

// ─── Core User ────────────────────────────────────────────────────────────────

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  phone         String?       @unique
  passwordHash  String
  role          Role
  status        AccountStatus @default(ACTIVE)
  language      String        @default("en")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  farmerProfile    FarmerProfile?
  buyerProfile     BuyerProfile?
  adminProfile     AdminProfile?
  notifications    Notification[]
  conversations    Conversation[]
  aiRequests       AIRequest[]
  auditLogs        AuditLog[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model FarmerProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  name        String
  village     String?
  taluka      String?
  district    String
  state       String   @default("Gujarat")
  pincode     String?
  latitude    Float?
  longitude   Float?
  riskProfile String   @default("MODERATE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  crops        FarmerCrop[]
  transactions Transaction[]

  @@map("farmer_profiles")
}

model BuyerProfile {
  id                  String                  @id @default(uuid())
  userId              String                  @unique
  user                User                    @relation(fields: [userId], references: [id])
  companyName         String
  contactName         String
  district            String
  state               String                  @default("Gujarat")
  latitude            Float?
  longitude           Float?
  verificationStatus  BuyerVerificationStatus @default(PENDING)
  verifiedAt          DateTime?
  verifiedBy          String?
  rating              Float?                  @default(0)
  totalTransactions   Int                     @default(0)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  requirements  BuyerRequirement[]
  offers        BuyerOffer[]
  transactions  Transaction[]
  verification  BuyerVerification?

  @@map("buyer_profiles")
}

model AdminProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_profiles")
}

// ─── Crop ─────────────────────────────────────────────────────────────────────

model Crop {
  id          String   @id @default(uuid())
  name        String   @unique
  nameHi      String?
  nameGu      String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  farmerCrops      FarmerCrop[]
  buyerRequirements BuyerRequirement[]
  buyerOffers      BuyerOffer[]
  marketPrices     MarketPrice[]

  @@map("crops")
}

model FarmerCrop {
  id                String        @id @default(uuid())
  farmerProfileId   String
  farmerProfile     FarmerProfile @relation(fields: [farmerProfileId], references: [id])
  cropId            String
  crop              Crop          @relation(fields: [cropId], references: [id])
  totalQuantity     Float
  availableQuantity Float
  soldQuantity      Float         @default(0)
  unit              String        @default("quintal")
  quality           CropQuality   @default(UNGRADED)
  harvestDate       DateTime?
  storageStatus     StorageStatus @default(NOT_STORED)
  expectedPrice     Float?
  location          String
  district          String
  notes             String?
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  qualityAssessments QualityAssessment[]
  aiRecommendations  AIRecommendation[]
  transactions       Transaction[]

  @@index([farmerProfileId])
  @@index([cropId])
  @@map("farmer_crops")
}

// ─── Mandi & Market ───────────────────────────────────────────────────────────

model Mandi {
  id        String   @id @default(uuid())
  name      String
  nameHi    String?
  nameGu    String?
  district  String
  state     String   @default("Gujarat")
  latitude  Float?
  longitude Float?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  marketPrices MarketPrice[]

  @@map("mandis")
}

model MarketPrice {
  id             String     @id @default(uuid())
  mandiId        String
  mandi          Mandi      @relation(fields: [mandiId], references: [id])
  cropId         String
  crop           Crop       @relation(fields: [cropId], references: [id])
  minPrice       Float
  maxPrice       Float
  modalPrice     Float
  arrivalQty     Float?
  priceDate      DateTime
  trend          PriceTrend @default(STABLE)
  priceChangePct Float?
  source         String     @default("MOCK")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([cropId])
  @@index([mandiId])
  @@index([priceDate])
  @@map("market_prices")
}

// ─── Buyer Marketplace ────────────────────────────────────────────────────────

model BuyerRequirement {
  id              String       @id @default(uuid())
  buyerProfileId  String
  buyerProfile    BuyerProfile @relation(fields: [buyerProfileId], references: [id])
  cropId          String
  crop            Crop         @relation(fields: [cropId], references: [id])
  minQuantity     Float
  maxQuantity     Float
  quality         CropQuality  @default(GRADE_B)
  offeredPrice    Float
  district        String?
  notes           String?
  isActive        Boolean      @default(true)
  expiresAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  offers BuyerOffer[]

  @@index([cropId])
  @@index([buyerProfileId])
  @@map("buyer_requirements")
}

model BuyerOffer {
  id                  String           @id @default(uuid())
  buyerProfileId      String
  buyerProfile        BuyerProfile     @relation(fields: [buyerProfileId], references: [id])
  cropId              String
  crop                Crop             @relation(fields: [cropId], references: [id])
  requirementId       String?
  requirement         BuyerRequirement? @relation(fields: [requirementId], references: [id])
  offeredPrice        Float
  minQuantity         Float
  maxQuantity         Float
  quality             CropQuality      @default(GRADE_B)
  district            String
  state               String           @default("Gujarat")
  latitude            Float?
  longitude           Float?
  notes               String?
  isActive            Boolean          @default(true)
  expiresAt           DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  transactions Transaction[]

  @@index([cropId])
  @@index([buyerProfileId])
  @@index([isActive])
  @@map("buyer_offers")
}

model BuyerVerification {
  id             String                  @id @default(uuid())
  buyerProfileId String                  @unique
  buyerProfile   BuyerProfile            @relation(fields: [buyerProfileId], references: [id])
  status         BuyerVerificationStatus @default(PENDING)
  documentType   String?
  documentNumber String?
  notes          String?
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@map("buyer_verifications")
}

// ─── Transactions ─────────────────────────────────────────────────────────────

model Transaction {
  id                String            @id @default(uuid())
  farmerProfileId   String
  farmerProfile     FarmerProfile     @relation(fields: [farmerProfileId], references: [id])
  buyerProfileId    String
  buyerProfile      BuyerProfile      @relation(fields: [buyerProfileId], references: [id])
  farmerCropId      String
  farmerCrop        FarmerCrop        @relation(fields: [farmerCropId], references: [id])
  buyerOfferId      String?
  buyerOffer        BuyerOffer?       @relation(fields: [buyerOfferId], references: [id])
  quantity          Float
  agreedPrice       Float
  transportCost     Float             @default(0)
  storageCost       Float             @default(0)
  platformFee       Float             @default(0)
  netRealization    Float
  status            TransactionStatus @default(OFFER_CREATED)
  statusHistory     Json              @default("[]")
  notes             String?
  completedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([farmerProfileId])
  @@index([buyerProfileId])
  @@index([status])
  @@map("transactions")
}

// ─── AI & Quality ─────────────────────────────────────────────────────────────

model QualityAssessment {
  id              String     @id @default(uuid())
  farmerCropId    String
  farmerCrop      FarmerCrop @relation(fields: [farmerCropId], references: [id])
  estimatedGrade  CropQuality
  confidence      Float
  priceRangeMin   Float
  priceRangeMax   Float
  observations    Json       @default("[]")
  imageUrl        String?
  aiProvider      String     @default("MOCK")
  warning         String?
  createdAt       DateTime   @default(now())

  @@map("quality_assessments")
}

model AIRecommendation {
  id                      String                  @id @default(uuid())
  farmerCropId            String?
  farmerCrop              FarmerCrop?             @relation(fields: [farmerCropId], references: [id])
  userId                  String
  decision                RecommendationDecision
  recommendedSellQty      Float?
  recommendedHoldQty      Float?
  confidence              Float
  riskLevel               RiskLevel               @default(MEDIUM)
  reasoning               Json                    @default("[]")
  explanation             String?
  agentsUsed              Json                    @default("[]")
  inputContext            Json                    @default("{}")
  dataTimestamp           DateTime
  aiProvider              String                  @default("MOCK")
  createdAt               DateTime                @default(now())

  @@map("ai_recommendations")
}

model AIRequest {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  query          String
  intent         String?
  agentsUsed     Json     @default("[]")
  response       String?
  executionMs    Int?
  success        Boolean  @default(true)
  errorMessage   String?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@map("ai_requests")
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@map("notifications")
}

// ─── Conversation ─────────────────────────────────────────────────────────────

model Conversation {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  messages  Json      @default("[]")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("conversations")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entity     String
  entityId   String?
  changes    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

// ─── Storage Option ───────────────────────────────────────────────────────────

model StorageOption {
  id           String   @id @default(uuid())
  name         String
  location     String
  district     String
  costPerUnit  Float
  unit         String   @default("quintal/month")
  available    Boolean  @default(true)
  capacity     Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("storage_options")
}
