NODE_ENV=development
PORT=5000

DATABASE_URL=postgresql://postgres:password@localhost:5432/kisanmitra_db

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── IBM watsonx.ai (Granite) Configuration ───────────────────────────────────
#
# Used by the Agentic AI Orchestrator (ReAct tool-calling loop).
# When AI_PROVIDER=GRANITE the orchestrator calls the watsonx.ai Chat API
# (/ml/v1/text/chat) with tool definitions for three specialist agents:
#   • get_price_forecast  — mandiPriceForecastingAgent
#   • find_buyers         — buyerMatchingAgent
#   • storage_advisor     — storageSellingAdvisorAgent
#
# The IBM_GRANITE_API_KEY is an IBM Cloud API key.
# It is NOT used directly as a Bearer token — the backend automatically
# exchanges it for an IAM access token via:
#   POST https://iam.cloud.ibm.com/identity/token
#
# HOW TO GET CORRECT VALUES from IBM Cloud:
#
# 1. IBM_GRANITE_API_KEY
#    → Go to: cloud.ibm.com → Manage → Access (IAM) → API keys → Create
#    → OR: cloud.ibm.com → Manage → Access (IAM) → My IBM Cloud API keys
#    → Copy the key value (shown only once at creation)
#
# 2. IBM_GRANITE_ENDPOINT  ← THE MOST COMMON MISTAKE
#    → This must be the watsonx.ai REGIONAL ML endpoint, NOT Watson Orchestrate.
#    → Go to: dataplatform.cloud.ibm.com → your watsonx project → Manage → Details
#    → OR pick the correct region:
#       US South (Dallas):   https://us-south.ml.cloud.ibm.com  ← USE THIS (see note 4)
#       EU Germany:          https://eu-de.ml.cloud.ibm.com
#       EU UK:               https://eu-gb.ml.cloud.ibm.com
#       Japan (Tokyo):       https://jp-tok.ml.cloud.ibm.com
#       Australia (Sydney):  https://au-syd.ml.cloud.ibm.com    ← granite-4 NOT available here
#    ⚠ Do NOT use watson-orchestrate.cloud.ibm.com — that is a different product.
#    ⚠ Do NOT include /instances/... — just the base regional URL.
#
# 3. IBM_WATSONX_PROJECT_ID
#    → Go to: dataplatform.cloud.ibm.com → your watsonx.ai project → Manage tab
#    → Copy the "Project ID" (UUID format, e.g. be6455f8-2df1-4e30-...)
#
# 4. IBM_GRANITE_MODEL  ← CRITICAL — MODEL AVAILABILITY IS REGION-SPECIFIC
#    → The Chat API requires a model that supports tool_calling / function calling.
#
#    RECOMMENDED (use with us-south or eu-de endpoint):
#       ibm/granite-4-h-small             ← current generation, best tool calling
#                                            ⚠ Only available in us-south and eu-de
#                                            ⚠ Returns 404 on au-syd / eu-gb / jp-tok
#
#    FALLBACK (works in all regions, deprecated — withdrawn 22 Feb 2026):
#       ibm/granite-3-8b-instruct         ← still works, supports tool calling
#                                            available: us-south, eu-de, eu-gb, au-syd
#
#    NOT SUPPORTED for tool calling (returns 404 or ignores tools):
#       ibm/granite-13b-instruct-v2       ← text generation only, no Chat API
#       ibm/granite-3-2b-instruct         ← withdrawn 12 Nov 2025
#       ibm/granite-4-h-tiny/micro        ← deploy-on-demand only (not multitenant)
#
#    To programmatically list models with tool calling in your region:
#       GET https://<endpoint>/ml/v1/foundation_model_specs?version=2024-10-10&filters=task_function_calling
#
IBM_GRANITE_API_KEY=your-ibm-cloud-api-key-here
IBM_GRANITE_ENDPOINT=https://us-south.ml.cloud.ibm.com
IBM_GRANITE_MODEL=ibm/granite-4-h-small
IBM_WATSONX_PROJECT_ID=your-watsonx-project-id-here

# ─── AI Provider mode ─────────────────────────────────────────────────────────
#
# GRANITE — enables the full agentic ReAct loop using the watsonx.ai Chat API.
#           The orchestrator runs up to 6 tool-calling iterations, invoking the
#           three specialist agents above before synthesising a final answer.
#           Falls back to MOCK automatically if the Granite API is unreachable.
#
# MOCK    — uses deterministic in-process responses; no IBM credentials needed.
#           Suitable for local development and CI.
#
AI_PROVIDER=MOCK

# ─── Market Data ───────────────────────────────────────────────────────────────
#
# MOCK  — seeded/in-database market prices are used (no external API call).
# REAL  — set MARKET_DATA_API_URL and MARKET_DATA_API_KEY for a live data feed.
#
MARKET_DATA_PROVIDER=MOCK
MARKET_DATA_API_URL=
MARKET_DATA_API_KEY=

# ─── File Upload ───────────────────────────────────────────────────────────────
#
# Crop images and documents uploaded by farmers are stored here.
# STORAGE_PROVIDER=LOCAL stores files under UPLOAD_DIR on the server filesystem.
# Increase MAX_FILE_SIZE_MB for higher-resolution crop photos if needed.
#
STORAGE_PROVIDER=LOCAL
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
